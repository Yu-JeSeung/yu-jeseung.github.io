---
import BaseLayout from "./BaseLayout.astro";

const { post } = Astro.props;
const formattedDate = post.data.pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <a class="back-link" href={`${import.meta.env.BASE_URL}blog/`}>← 글 목록</a>
    <header class="article-header">
      <p class="eyebrow">{formattedDate}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-row" aria-label="태그">
        {post.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
