---
import BaseLayout from "./BaseLayout.astro";

const { post, previousPost, nextPost } = Astro.props;
const base = import.meta.env.BASE_URL;
const formattedDate = post.data.pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric"
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <a class="back-link" href={`${import.meta.env.BASE_URL}blog/`}>← 글 목록</a>
    <header class="article-header">
      <p class="eyebrow">{formattedDate}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-row" aria-label="태그">
        {post.data.tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
    {
      (previousPost || nextPost) && (
        <nav class="post-navigation" aria-label="이전 글과 다음 글">
          {
            nextPost ? (
              <a class="post-nav-card next-post" href={`${base}blog/${nextPost.id}/`}>
                <span>← 이후 글</span>
                <strong>{nextPost.data.title}</strong>
              </a>
            ) : (
              <span class="post-nav-spacer" aria-hidden="true"></span>
            )
          }
          {
            previousPost ? (
              <a class="post-nav-card previous-post" href={`${base}blog/${previousPost.id}/`}>
                <span>이전 글 →</span>
                <strong>{previousPost.data.title}</strong>
              </a>
            ) : (
              <span class="post-nav-spacer" aria-hidden="true"></span>
            )
          }
        </nav>
      )
    }
  </article>
  <script is:inline>
    (() => {
      const prose = document.querySelector(".prose");
      if (!prose) return;

      const calloutLabels = {
        note: "Note",
        tip: "Tip",
        warning: "Warning",
        important: "Important",
        check: "Check"
      };

      prose.querySelectorAll("blockquote").forEach((blockquote) => {
        const firstParagraph = blockquote.querySelector("p");
        const marker = firstParagraph?.textContent?.trim().match(/^\[!(NOTE|TIP|WARNING|IMPORTANT|CHECK)\]/i);
        if (!marker || !firstParagraph) return;

        const type = marker[1].toLowerCase();
        blockquote.classList.add("callout", `callout-${type}`);
        firstParagraph.innerHTML = firstParagraph.innerHTML.replace(
          /^\s*\[!(?:NOTE|TIP|WARNING|IMPORTANT|CHECK)\]\s*/i,
          ""
        );

        const label = document.createElement("strong");
        label.className = "callout-title";
        label.textContent = calloutLabels[type] ?? "Note";
        blockquote.prepend(label);
      });

      prose.querySelectorAll("pre > code").forEach((code) => {
        const language = Array.from(code.classList)
          .find((className) => className.startsWith("language-"))
          ?.replace("language-", "");

        if (language && code.parentElement) {
          code.parentElement.dataset.language = language.toUpperCase();
        }
      });
    })();
  </script>
</BaseLayout>
