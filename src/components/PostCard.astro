---
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "short",
  day: "numeric"
});
---

<a class="post-card" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
  <div class="card-content">
    <span class="post-date">{date}</span>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
  </div>
  <div class="tag-row card-tags">
    {post.data.tags.map((tag: string) => <span>{tag}</span>)}
  </div>
  <span class="card-action">더 읽기 →</span>
</a>
